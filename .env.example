# 預設僅示範；不需要任何金鑰。
VITE_HELPDESK_MODE=demo

# 只有後端契約已實作與驗收後，才改為 live 並填入：
# VITE_ADMIN_API_URL=https://your-admin-api.example.test
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# 所有 VITE_ 值都會打包進瀏覽器。不可填 service_role、LINE token、加密金鑰。
